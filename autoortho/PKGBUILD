# Maintainer SuitablyMysterious <suitablymysterious@gmail.com>

pkgname=autoortho-bin
_pkgname=autoortho
pkgver=0.7.2
pkgrel=1
arch=('x86_64')
depends=('fuse2')
url='https://github.com/kubilus1/autoortho/'
license=('Apache-2.0')
options=('!strip')

source=("$url/releases/download/$pkgver/autoortho_lin_$pkgver.bin"
		"$_pkgname.png::https://raw.githubusercontent.com/kubilus1/autoortho/$pkgver/autoortho/imgs/ao-icon.png"
		"$_pkgname.desktop")

sha256sums=('a419c08b8e8ee67a3601963844d67ef2330264e843454ba04d6eaad1c3b22e9b'
            '184cc6d39a4a0eb52a84dda04598766d3124d2a84b18b2c81486914e6be40cd8'
            '45cffcce7a4544fedd55ed8952ae506419183dfc8c3514f4f48560a4e9cc6136')

package() {
    install -Dm755 "$srcdir/${_pkgname}_lin_${pkgver}.bin" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
    install -Dm644 "$srcdir/$_pkgname.png" "$pkgdir/usr/share/pixmaps/$_pkgname.png"
}
